# =============================================================================
# Eidolon - GitIgnore
# IMPORTANT: Protège les données sensibles et clés cryptographiques
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
wheels/
*.egg
MANIFEST

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
venv/
.venv/
env/
ENV/

# -----------------------------------------------------------------------------
# IDE
# -----------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# SENSITIVE DATA - CRITICAL SECURITY
# -----------------------------------------------------------------------------

# Vault cryptographic keys (NEVER COMMIT)
*.psnx
*.blend_data
*.blend
*.blend1
*.eidolon_keybundle
*.keybundle
*.vault_key
*.master_key
*.private_key
*.secret_key
*.private-key
*.secret-key
*.seed
*.mnemonic
*seed_phrase*
*mnemonic*

# Encrypted vault data
vault_storage/data/
vault_storage/keys/*.psnx
vault_storage/keys/*.blend_data
vault_storage/keys/*.enc
vault_storage/documents/*.enc
vault_storage/persistent/
vault_storage/backups/*.enc
vault_storage/backups/*.tar.gz
vault_storage/backups/*.zip

# Avatar and identity files
vault_storage/avatars/*.png
vault_storage/avatars/*.jpg

# Salt and key files
*.salt
*.key
*.pem
*.p12
*.pfx

# Environment files with secrets
.env
.env.*
!.env.example

# Wallet and blockchain keys
**/wallet_*.json
*wallet*.json
**/keystore/
*.keystore

# -----------------------------------------------------------------------------
# Quantum/Post-Quantum sensitive data
# -----------------------------------------------------------------------------

# Lattice-based keys
*.lattice_key
*.kyber_key
*.dilithium_key
*.ntru_key

# Bell state data
*.bell_state
*.epr_data
*.quantum_state

# Spinor cryptographic data
*.spinor_key
*.clifford_data

# -----------------------------------------------------------------------------
# Keep directory structure (empty dirs for git)
# -----------------------------------------------------------------------------
!vault_storage/.gitkeep
!vault_storage/keys/.gitkeep
!vault_storage/data/.gitkeep
!vault_storage/documents/.gitkeep
!vault_storage/persistent/.gitkeep
!vault_storage/backups/.gitkeep
!vault_storage/avatars/.gitkeep
!vault_storage/logs/.gitkeep

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs and temp files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
logs/
*.cache

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# -----------------------------------------------------------------------------
# Build artifacts
# -----------------------------------------------------------------------------
*.spec
specs/

# -----------------------------------------------------------------------------
# Documentation build
# -----------------------------------------------------------------------------
docs/_build/
site/

# -----------------------------------------------------------------------------
# Documentation source is tracked by default. Put private notes under scratch/
# or another ignored local directory instead of relying on broad Markdown rules.

# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------
*.local
.local/
scratch/
tmp/

# Diagnostic and test outputs
diag_*.txt
test_*.txt
error_out.txt
vault1_redist.txt
*.err.log
*.out.log

# Runtime data directories
holotest/
hsm_data/
backups/
alchemical_vault/
genesis_spheres/
runes_vesting/
vault_incubation/
_recovery_from_prod/

node_modules/
vault_storage/

# New data directory structure (replaces vault_storage)
data/api/
data/connect/
data/registrations/
data/vaults/
data/items/
data/avatars/
data/cipher_activity/
data/daemon/
data/realms/
data/genesis/
data/blockchain/
data/lairs/
!data/.gitkeep
!data/vaults/.gitkeep

# -----------------------------------------------------------------------------
# Contract / frontend build artifacts
# -----------------------------------------------------------------------------
contracts/artifacts/
contracts/artifacts_*/
contracts/cache/
contracts/cache_*/
contracts/typechain/
contracts/coverage/
contracts/.env
contracts/.env.*
!contracts/.env.example

# -----------------------------------------------------------------------------
# Proprietary / security-critical source code
# -----------------------------------------------------------------------------
# Cryptographic key-generation pipeline and vault internals.
src/crypto/
src/identity/
src/core/

# Proprietary holographic/economy/blockchain subsystems.
src/holo/
src/game/
src/blockchain/

# Internal application layers and dormant experiments.
src/api/
src/ui/
src/utils/
src/_dormant/

# Native cryptographic implementation.
/rust/

# Sensitive scripts: key generation, migration, admin, and test-vector tooling.
scripts/

# SDK key-generation / crypto mirrors.
sdk/**/keygen.*
sdk/**/crypto.*
sdk/**/vault.*

# -----------------------------------------------------------------------------
# Local IDE / agent configuration
# -----------------------------------------------------------------------------
.claude/
CLAUDE.md

# -----------------------------------------------------------------------------
# Internal documents (NEVER PUBLISH)
# Entire docs/ tree is kept private — business plans, security audits,
# deployment notes, whitepapers, and internal references all live here.
# -----------------------------------------------------------------------------
PHASE2_ROADMAP.md
docs/*
!docs/FORMAL_SPEC.md
!docs/THREAT_MODEL.md
!docs/TEST_VECTORS.json
!docs/REPRODUCIBLE_BUILDS.md

# -----------------------------------------------------------------------------
# Deployment scripts and infrastructure configs
# Contains VPS IPs, internal ports, HMAC secrets, nginx/systemd configs.
# NEVER PUBLISH.
# -----------------------------------------------------------------------------
deploy/
__pycache__/
*.pyc

# -----------------------------------------------------------------------------
# Incubator (legacy subsystem from earlier prototype, not shipped publicly)
# -----------------------------------------------------------------------------
config/incubator_config.py
*incubator*
*incubation*

# -----------------------------------------------------------------------------
# Local user override config (may contain real API keys, RPC tokens, etc.)
# -----------------------------------------------------------------------------
config/user_config.json

# -----------------------------------------------------------------------------
# Windows entry-point batch scripts that depend on protected src/ui/ code
# -----------------------------------------------------------------------------
realms.bat
realms_shell.bat
launcher.bat

# -----------------------------------------------------------------------------
# Smart contracts and deployment artifacts.
# Kept private until mainnet deploy + audit; will be unlocked alongside the
# verified Etherscan source + audit report at v1.0 contract release.
# -----------------------------------------------------------------------------
contracts/
deployments/
