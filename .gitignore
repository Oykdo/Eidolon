# =============================================================================
# Eidolon - GitIgnore
# IMPORTANT: Protège les données sensibles et clés cryptographiques
# =============================================================================

# -----------------------------------------------------------------------------
# Local scratch / generated artifacts (never released — see CLAUDE.md IP rules)
# genesis_e2e_* are traces of the proprietary genesis ceremony.
# -----------------------------------------------------------------------------
genesis_e2e_*
_debug_*.py
_diff_*.py
_verify_*.py

# Build / release output dirs and helper scripts (regenerated by CI)
release-*/
build-linux.sh
build-linux/
dist-linux/

# Runtime / generated vault state
vault_evolution/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
