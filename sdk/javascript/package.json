{
  "name": "@psnx/sdk",
  "version": "1.0.0",
  "description": "Eidolon SDK for JavaScript/TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "cryptography",
    "vault",
    "zkp",
    "zero-knowledge",
    "security",
    "encryption"
  ],
  "author": "Poly-Spinor Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/poly-spinor/nexus-7d"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
