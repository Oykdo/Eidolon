{
  "version": "1.0",
  "vault_settings": {
    "persistence": {
      "auto_save_interval": 300,
      "backup_count": 10,
      "backup_interval": 86400,
      "backup_retention_days": 30,
      "compress_backups": true
    },
    "security": {
      "require_dual_key": true,
      "max_login_attempts": 3,
      "session_timeout": 3600,
      "auto_lock_minutes": 15,
      "bell_verification_interval": 60,
      "kdf_iterations": 100000,
      "enable_audit_log": true
    },
    "monitoring": {
      "enabled": true,
      "check_interval": 30,
      "alert_threshold": 80,
      "report_interval": 3600,
      "prometheus_enabled": false,
      "prometheus_port": 9090
    },
    "transfers": {
      "default_delay_days": 30,
      "min_delay_days": 1,
      "max_delay_days": 365,
      "auto_execute": true,
      "confirmation_required": true,
      "notification_before_days": 3
    }
  },
  "chains": {
    "ethereum": {
      "rpc": "https://eth-mainnet.g.alchemy.com/v2/demo",
      "chain_id": 1,
      "explorer": "https://etherscan.io",
      "symbol": "ETH",
      "enabled": true
    },
    "polygon": {
      "rpc": "https://polygon-rpc.com",
      "chain_id": 137,
      "explorer": "https://polygonscan.com",
      "symbol": "MATIC",
      "enabled": true
    },
    "arbitrum": {
      "rpc": "https://arb1.arbitrum.io/rpc",
      "chain_id": 42161,
      "explorer": "https://arbiscan.io",
      "symbol": "ETH",
      "enabled": true
    },
    "optimism": {
      "rpc": "https://mainnet.optimism.io",
      "chain_id": 10,
      "explorer": "https://optimistic.etherscan.io",
      "symbol": "ETH",
      "enabled": true
    },
    "bsc": {
      "rpc": "https://bsc-dataseed.binance.org",
      "chain_id": 56,
      "explorer": "https://bscscan.com",
      "symbol": "BNB",
      "enabled": true
    },
    "avalanche": {
      "rpc": "https://api.avax.network/ext/bc/C/rpc",
      "chain_id": 43114,
      "explorer": "https://snowtrace.io",
      "symbol": "AVAX",
      "enabled": false
    },
    "base": {
      "rpc": "https://mainnet.base.org",
      "chain_id": 8453,
      "explorer": "https://basescan.org",
      "symbol": "ETH",
      "enabled": false
    }
  },
  "storage": {
    "vault_directory": "vault_storage/persistent",
    "documents_directory": "vault_storage/documents",
    "keys_directory": "vault_storage/keys",
    "backups_directory": "vault_storage/backups",
    "logs_directory": "vault_storage/logs",
    "max_document_size_mb": 100,
    "max_vault_size_gb": 10,
    "encryption_algorithm": "AES-256-GCM",
    "compression_enabled": true,
    "compression_level": 6
  },
  "ui": {
    "theme": "dark",
    "language": "fr",
    "window_width": 1400,
    "window_height": 900,
    "show_notifications": true,
    "confirm_actions": true,
    "auto_refresh_seconds": 30,
    "date_format": "%Y-%m-%d %H:%M:%S",
    "show_advanced_options": false
  },
  "notifications": {
    "enabled": true,
    "on_transfer_due": true,
    "on_security_alert": true,
    "on_backup_complete": false,
    "on_integrity_warning": true,
    "webhook_url": "",
    "email_enabled": false,
    "email_recipients": []
  },
  "api": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8080,
    "require_auth": true,
    "cors_origins": ["http://localhost:3000"],
    "rate_limit": 100
  },
  "advanced": {
    "debug_mode": false,
    "log_level": "INFO",
    "max_log_size_mb": 50,
    "log_rotation_count": 5,
    "gc_interval": 3600,
    "cache_ttl_seconds": 300,
    "thread_pool_size": 4
  }
}
