# =============================================================================
# Eidolon - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
VAULT_ENV=development
VAULT_DEBUG=false
VAULT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Eidolon Connect / API
# -----------------------------------------------------------------------------
# Local/dev defaults
VAULT_API_ENABLED=true
VAULT_API_HOST=127.0.0.1
VAULT_API_PORT=8000

# Stable JWT signing secret for Eidolon API sessions.
# In production, set this explicitly and keep it private.
EIDOLON_JWT_SECRET=replace-with-a-long-random-secret

# Admin secret for sensitive operator actions such as:
# - POST /connect/apps/{app_id}/approve
# - POST /connect/apps/{app_id}/revoke
EIDOLON_ADMIN_SECRET=replace-with-a-long-random-admin-secret

# Shared secret for trusted remote callers allowed to create Connect sessions.
# Local loopback calls still work by default for desktop flows.
EIDOLON_CONNECT_SESSION_SECRET=replace-with-a-long-random-connect-secret

# Comma-separated list of browser origins allowed by CORS.
# Keep this narrow in production.
EIDOLON_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Hardening toggles
EIDOLON_ALLOW_LOCAL_ADMIN=true
EIDOLON_ALLOW_LOCAL_CONNECT_SESSION=true

# Demo crypto endpoints are hidden by default.
# Set to 1 only if you intentionally want the demo vault APIs exposed.
EIDOLON_ENABLE_DEMO_VAULT_API=0

# -----------------------------------------------------------------------------
# Blockchain RPC Endpoints
# Replace with your own API keys
# -----------------------------------------------------------------------------
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Infura (alternative)
# INFURA_PROJECT_ID=your-infura-project-id

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
VAULT_PROMETHEUS_ENABLED=false
VAULT_PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# Redis (for caching/sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Warning: Never commit real keys!
VAULT_MASTER_KEY=
ENCRYPTION_SALT=

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
