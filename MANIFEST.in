# MANIFEST.in - Control what goes into distribution
# IMPORTANT: Excludes proprietary/protected code

# Include essential files
include README.md
include LICENSE
include pyproject.toml

# Include config
recursive-include config *.json *.yaml *.yml

# Include only the PUBLIC source packages (IP-BOUNDARY.md, Tier 1): the same
# set a public clone has. Keep in step with [tool.setuptools.packages.find].
recursive-include src/daemon *.py
recursive-include src/protocols *.py

# EXCLUDE PRIVATE PACKAGES (Tier 2, git-ignored) - never in an sdist or wheel
prune src/crypto
prune src/core
prune src/holo
prune src/game
prune src/blockchain
prune src/identity
prune src/api
prune src/ui
prune src/utils
prune src/_dormant
exclude config/user_config.json
global-exclude *incubator*

# Exclude build/test artifacts
prune tests
prune docs
prune rust
prune contracts
prune backups
prune data
prune deployments
prune build
prune dist
prune *.egg-info

# Exclude sensitive files
global-exclude *.psnx
global-exclude *.blend_data
global-exclude *.pyc
global-exclude __pycache__
global-exclude .git*
global-exclude .env*
