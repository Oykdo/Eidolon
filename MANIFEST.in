# =============================================================================
# Poly-Spinor Nexus 7D - MANIFEST.in
# =============================================================================

# Documentation
include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md

# Configuration files
include pyproject.toml
include setup.cfg
include requirements.txt
include requirements-dev.txt

# Config directory
recursive-include config *.json
recursive-include config *.yaml
recursive-include config *.yml

# Docker files
include Dockerfile
include Dockerfile.backup
include docker-compose.yml
include .dockerignore
recursive-include docker *.yml
recursive-include docker *.yaml
recursive-include docker *.sh

# Package data
recursive-include core *.py
recursive-include protocols *.py
recursive-include ui *.py
recursive-include utils *.py
recursive-include scripts *.py
recursive-include vault_storage *.py

# Tests
recursive-include tests *.py
recursive-include tests *.json

# Static files
recursive-include static *.css
recursive-include static *.js
recursive-include static *.html
recursive-include static *.png
recursive-include static *.ico

# Templates
recursive-include templates *.html
recursive-include templates *.jinja2

# Exclude unwanted files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.dylib
global-exclude .DS_Store
global-exclude Thumbs.db
global-exclude *.log
global-exclude *.tmp
global-exclude *.bak
global-exclude .git*
global-exclude .env
global-exclude .env.*
global-exclude *.psnx
global-exclude *.blend_data
global-exclude *.enc

# Exclude build artifacts
prune build
prune dist
prune *.egg-info
prune .pytest_cache
prune .mypy_cache
prune .tox
prune htmlcov
prune __pycache__
