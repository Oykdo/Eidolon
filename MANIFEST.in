# MANIFEST.in - Control what goes into distribution
# IMPORTANT: Excludes proprietary/protected code

# Include essential files
include README.md
include LICENSE
include pyproject.toml

# Include config
recursive-include config *.json *.yaml *.yml

# Include only PUBLIC source modules
recursive-include src/daemon *.py
recursive-include src/identity *.py
recursive-include src/api *.py
recursive-include src/ui *.py
recursive-include src/utils *.py

# EXCLUDE PROTECTED MODULES - These require Rust eidolon_crypto module
prune src/crypto
prune src/core
prune src/holo
prune src/game
prune src/blockchain
prune src/_dormant

# Exclude build/test artifacts
prune tests
prune docs
prune rust
prune contracts
prune backups
prune data
prune deployments
prune build
prune dist
prune *.egg-info

# Exclude sensitive files
global-exclude *.psnx
global-exclude *.blend_data
global-exclude *.pyc
global-exclude __pycache__
global-exclude .git*
global-exclude .env*
